rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == 'info@rgb-workshop.com';
    }
    match /miniGames/yesCardGacha {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /miniGames/hongKongFishing {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /miniGames/hongKongFishingPro {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
